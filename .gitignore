# Terraform state files (contain infrastructure secrets)
*.tfstate
*.tfstate.*
.terraform/
terraform.tfstate.backup

# Terraform variable files with sensitive values
*.tfvars
*.tfvars.json
!*.tfvars.example

# AWS credentials
.aws/
aws-credentials*

# Environment files with secrets
.env
.env.local
.env.*.local

# SSH keys
*.pem
*.key
id_rsa*

# Python
__pycache__/
*.pyc

# Terraform plan files
tfplan
*.tfplan

# Python virtual environment
.venv/

# macOS
.DS_Store
